@model List<HuntingLog>

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-10">
            <h2 class="text-primary">Hunting logs</h2>
        </div>
        <div class="col-2 text-right">
            <a asp-action="Upsert" class="btn btn-success">
                New log
            </a>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <partial name="_HuntingLogCard" model="item" />
        }
    </div>
</div>
